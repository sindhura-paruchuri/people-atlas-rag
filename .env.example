# Copy to .env; do not commit real secrets. Use URL-safe generated passwords.
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-password
DATABASE_URL=mysql+pymysql://atlas:replace-with-random-password@mysql:3306/atlas
RAG_API_TOKEN=replace-with-random-token
INTERNAL_TOKEN=replace-with-different-random-token
MCP_URL=http://mcp:8000/mcp
# Leave RAG_API_URL empty for the hosted sample workspace.
# Set to http://127.0.0.1:8000 for local frontend, HTTPS API origin when hosted.
RAG_API_URL=
# OpenAI-compatible Chat Completions endpoint. Gemini supports this interface.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
# Optional overrides; one Gemini key otherwise powers both services.
GEMINI_API_KEY=
LLM_API_KEY=
# A compatible embeddings provider; model dimensions MUST match Pinecone index.
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
EMBEDDING_API_KEY=
PINECONE_HOST=https://your-index-host.svc.pinecone.io
PINECONE_API_KEY=
PINECONE_NAMESPACE=hotpotqa-v1
RETRIEVAL_THRESHOLD=0.78
SERPAPI_API_KEY=
# Optional comma-separated source domains, e.g. example.org,university.edu
WEB_ALLOWED_DOMAINS=
